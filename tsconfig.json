{
    "compileOnSave": true,
    "compilerOptions": {
        "target": "ES2020",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "lib": [
            "ESNext",
            "dom",
            "dom.iterable"
        ],
        "allowJs": true,
        "jsx": "preserve",
        "outDir": "./dist",
        "rootDir": "./miniprogram",
        "importHelpers": true,
        "strict": false,
        "typeRoots": [
            ".",
            "./node_modules",
            "./node_modules/@types"
        ],
        "types": ["typings", "miniprogram-api-typings"],
        "allowSyntheticDefaultImports": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "resolveJsonModule": true
    },
    "include": [
        "miniprogram/**/*.ts",
        "typings/**/*.d.ts", "miniprogram/mixins/lodash.js",
    ]
}
